# ---- Site ----------------------------------------------------------------
# Production URL, no trailing slash. Used for canonical links, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://efrat-tzari.co.il

# Search engines are blocked unless this is exactly "true". Flip it on the
# production domain only, once the real phone/email/images are in place.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---- Sanity CMS ----------------------------------------------------------
# Leave the project id empty and the site serves the seed content in /content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Write token (Editor role) — only needed to run `npm run seed`. Never expose.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook that refreshes the site after an edit.
SANITY_REVALIDATE_SECRET=

# ---- Contact form (Resend) ----------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=website@efrat-tzari.co.il
# Where enquiries land. Defaults to site.email when unset.
CONTACT_TO_EMAIL=
